import { test, expect } from '@fixtures/login.fixtures';
import { EXPECTED_TEXT, testUsers } from '../src/data/testData';


test.describe('dashboard flow', () => {
    test('Dashboard loads correctly', async ({ loginPage, dashboardPage }) => {
        const user = testUsers.allUsers[0];

        await loginPage.login(user.username, user.password);

        await expect(loginPage.page).toHaveURL(/inventory\.html/);
        await expect(dashboardPage.title).toBeVisible();
        await expect(dashboardPage.title).toHaveText(EXPECTED_TEXT.DASHBOARD_TITLE);

        const count = await dashboardPage.inventoryItems.count();
        expect(count).toBeGreaterThan(0);
    });
});
